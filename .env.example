# Copy to .env (gitignored) and fill in. Every demo reads it.

# Dashboard > Applications > your application. Voice requests carry a JWT signed with
# the application's private key, saved at the repo root.
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=./private.key

# Dashboard > API Settings > Signature secret. Vonage signs every webhook with it.
VONAGE_SIGNATURE_SECRET=

# Numbers in E.164 without the +, for example 34600000000.
# The caller ID: 123456789 on a trial account, a Vonage number you own on a paid one.
VONAGE_VIRTUAL_NUMBER=123456789
# The phone the reminders call. On a trial account, the number you signed up with.
# Leave it empty to take the call in your browser, with the phone demo (see the README).
VOICE_TO_NUMBER=
# The phone the WhatsApp reminder goes to: yours, once you have added it to the Messages Sandbox.
# Leave it empty and a call without an answer gets no message.
WHATSAPP_TO_NUMBER=
# Your own WhatsApp number, for whatsapp.ts, where the reminder is a template (see "Before
# production" in the README). The demo sends from the Messages Sandbox and leaves it empty.
WHATSAPP_FROM_NUMBER=

# The HTTPS URL of your tunnel to PORT, for example https://abc123.ngrok.app
PUBLIC_BASE_URL=
PORT=3000
